{
  "name": "@xiu-ai/cli",
  "version": "0.13.5",
  "description": "A safe terminal coding agent with risk-aware tools and multi-provider support.",
  "type": "module",
  "bin": {
    "xiu": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PUBLISHING.zh-CN.md",
    "USAGE.zh-CN.md",
    "ROADMAP.zh-CN.md",
    "SECURITY.zh-CN.md",
    "V0.13_DESIGN.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@modelcontextprotocol/client": "2.0.0",
    "chalk": "^5.4.1",
    "cheerio": "1.0.0",
    "commander": "^14.0.0",
    "csv-parse": "5.6.0",
    "fast-glob": "^3.3.3",
    "iconv-lite": "^0.6.3",
    "openai": "^5.12.2",
    "opencc-js": "^1.4.1",
    "typescript": "^5.9.2",
    "undici": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjr1991/xiu.git"
  },
  "homepage": "https://github.com/andrewjr1991/xiu#readme",
  "bugs": {
    "url": "https://github.com/andrewjr1991/xiu/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "multi-agent",
    "worktree",
    "mcp"
  ],
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
