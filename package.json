{
  "name": "@xiu-ai/cli",
  "version": "0.20.5",
  "description": "A safe terminal coding agent with risk-aware tools and multi-provider support.",
  "type": "module",
  "bin": {
    "xiu": "dist/cli.js"
  },
  "files": [
    "dist",
    "evals",
    "!evals/results",
    "scripts",
    "README.md",
    "README.zh-CN.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "PUBLISHING.zh-CN.md",
    "USAGE.zh-CN.md",
    "ROADMAP.zh-CN.md",
    "SECURITY.zh-CN.md",
    "V0.20.5_DESIGN.zh-CN.md",
    "docs/development-progress.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-ci-tests.mjs",
    "eval:validate": "node evals/validate.mjs",
    "eval:smoke": "node evals/run.mjs --suite smoke --trials 1",
    "eval:run": "node evals/run.mjs",
    "eval:real": "node evals/real-run.mjs",
    "eval:report": "node evals/report.mjs",
    "eval:compare": "node evals/compare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:platform": "node scripts/platform-smoke.mjs",
    "desktop:typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:smoke": "npm --prefix apps/desktop run smoke",
    "desktop:smoke:ui": "npm --prefix apps/desktop run smoke:ui",
    "desktop:pack:win": "npm --prefix apps/desktop run pack:win",
    "desktop:installer:win": "npm --prefix apps/desktop run installer:win",
    "desktop:installer:msix:win": "npm --prefix apps/desktop run installer:msix:win",
    "desktop:smoke:installer:win": "npm --prefix apps/desktop run smoke:installer:win",
    "desktop:smoke:installer:msix:win": "npm --prefix apps/desktop run smoke:installer:msix:win"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@modelcontextprotocol/client": "2.0.0",
    "chalk": "^5.4.1",
    "cheerio": "1.0.0",
    "commander": "^14.0.0",
    "csv-parse": "^7.0.3",
    "iconv-lite": "^0.6.3",
    "openai": "^5.12.2",
    "opencc-js": "^1.4.1",
    "tinyglobby": "0.2.17",
    "typescript": "^5.9.2",
    "undici": "7.29.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.20.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjr1991/xiu.git"
  },
  "homepage": "https://github.com/andrewjr1991/xiu#readme",
  "bugs": {
    "url": "https://github.com/andrewjr1991/xiu/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "multi-agent",
    "worktree",
    "mcp"
  ],
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
