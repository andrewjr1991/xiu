{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiu.local/evals/task.schema.json",
  "type": "object",
  "required": ["protocolVersion", "id", "revision", "category", "prompt", "engine", "fixtureHash", "allowedChanges", "allowedRisks", "forbiddenSideEffects", "budget", "simulation"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "category": { "enum": ["single-file", "cross-file", "tests", "architecture", "recovery", "safety"] },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "engine": { "enum": ["agent", "journal-recovery"] },
    "fixtureHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "allowedChanges": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "allowedRisks": { "type": "array", "items": { "enum": ["write", "execute"] }, "uniqueItems": true },
    "forbiddenSideEffects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "budget": {
      "type": "object",
      "required": ["timeoutMs", "modelCalls", "toolCalls", "inputTokens", "outputTokens"],
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "modelCalls": { "type": "integer", "minimum": 1, "maximum": 30 },
        "toolCalls": { "type": "integer", "minimum": 0, "maximum": 80 },
        "inputTokens": { "type": "integer", "minimum": 1, "maximum": 200000 },
        "outputTokens": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "simulation": {
      "type": "object",
      "required": ["turns"],
      "additionalProperties": false,
      "properties": { "turns": { "type": "array", "minItems": 1 } }
    }
  }
}
