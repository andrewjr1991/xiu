{
  "name": "@xiu-ai/desktop",
  "version": "0.20.1",
  "private": true,
  "description": "Xiu local-first desktop workbench.",
  "author": "Xiu",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run generate:assets && npm run build:main && npm run build:renderer",
    "generate:assets": "node scripts/generate-assets.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:win": "npm run build && node scripts/package-windows.mjs dir",
    "installer:win": "npm run build && node scripts/package-windows.mjs nsis",
    "installer:msix:win": "npm run build && node scripts/package-windows.mjs msix",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ui": "npm run build && electron scripts/ui-smoke-harness.cjs",
    "smoke:installer:win": "node scripts/windows-installer-smoke.mjs",
    "smoke:installer:msix:win": "node scripts/windows-msix-smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "sharp": "0.34.5",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "ai.xiu.desktop",
    "productName": "Xiu",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "dir",
        "nsis"
      ],
      "artifactName": "Xiu-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Xiu",
      "uninstallDisplayName": "Xiu",
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "artifactName": "Xiu-${version}-${arch}.msix",
      "applicationId": "Xiu",
      "identityName": "ai.xiu.desktop",
      "publisherDisplayName": "Xiu",
      "displayName": "Xiu",
      "languages": [
        "zh-CN",
        "en-US"
      ],
      "capabilities": [
        "runFullTrust"
      ]
    }
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
